      "item": [
        {
          "name": "Apply for New Account (Customer - 201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.account) {",
                  "    pm.collectionVariables.set('accountId', jsonData.data.account._id);",
