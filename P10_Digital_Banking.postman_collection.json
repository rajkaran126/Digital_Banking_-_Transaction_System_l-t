    {
      "name": "1. Authentication & RBAC",
      "item": [
        {
          "name": "Register Customer (Happy Path - 201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test('PasswordHash is never returned', function () {",
                  "    pm.expect(jsonData.data.user.passwordHash).to.be.undefined;",
                  "    pm.expect(jsonData.data.user.kycStatus).to.eql('pending');",
                  "});",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('token', jsonData.data.token);",
                  "    pm.collectionVariables.set('customerToken', jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bob Vance\",\n  \"email\": \"bob.vance@example.com\",\n  \"password\": \"Password@123\",\n  \"role\": \"customer\",\n  \"phone\": \"+1-555-0999\",\n  \"address\": {\n    \"street\": \"789 Industrial Blvd\",\n    \"city\": \"Scranton\",\n    \"state\": \"PA\",\n    \"postalCode\": \"18503\",\n    \"country\": \"USA\"\n  },\n  \"idDocumentType\": \"drivers_license\",\n  \"idDocumentNumber\": \"DL-11223344\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Register Validation Failure (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"email\": \"not-an-email\",\n  \"password\": \"123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
